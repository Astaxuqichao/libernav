<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>libernav_frontier_planner</name>
  <version>0.2.0</version>
  <description>ROGMap frontier candidate and path planning plugins for LiberNav 3D navigation.</description>
  <maintainer email="todo@example.com">libernav</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>nav2_common</depend>
  <depend>nav2_util</depend>
  <depend>libernav_rog_map</depend>
  <depend>libernav_rogmap_core</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>tf2_ros</depend>
  <depend>visualization_msgs</depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <export>
    <build_type>ament_cmake</build_type>
    <libernav_rogmap_core plugin="${prefix}/global_planner_plugin.xml" />
  </export>
</package>
